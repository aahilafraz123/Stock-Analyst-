# Copy this file to backend/.env and fill in your own keys.
# backend/.env is gitignored and must NEVER be committed.

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here
FINNHUB_API_KEY=your-finnhub-key-here           # free key: news, peers

# Strongly recommended: SEC asks automated clients to identify themselves
SEC_USER_AGENT="StockAnalyzer you@example.com"

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5               # any current Claude model id
# ANTHROPIC_EFFORT=medium                       # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=default                   # server-side refusal fallbacks; set empty to disable
# EARNINGSCALL_API_KEY=                         # without it only a few demo tickers have transcripts
# EMBEDDINGS=auto                               # auto | voyage | local | none
# VOYAGE_API_KEY=                               # enables finance-tuned dense retrieval (voyage-finance-2)
# CORS_ORIGINS=http://localhost:5173
# REPORT_TTL_SECONDS=21600                      # serve a stored report for 6h before regenerating
# DATA_DIR=./.data                              # SQLite cache, vector index and report history
